# ============================================
# نمونه تنظیمات ربات آرشیو ریاضی
# این فایل را کپی کنید و نامش را بگذارید: .env
# هرگز فایل .env واقعی را روی GitHub نگذارید.
# ============================================

# ----- اجباری -----

# توکن ربات از @BotFather
# مثال: 1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=

# آیدی عددی ادمین‌ها (با کاما جدا شوند)
# آیدی را از @userinfobot بگیرید
# مثال: 1612559025
# مثال چند ادمین: 1612559025,987654321
ADMIN_IDS=

# آدرس PostgreSQL
# Supabase (Pooler): Project Settings → Database → URI
# Neon: داشبورد پروژه → Connection string
# Railway: بعد از افزودن Postgres معمولاً خودکار است
# لوکال: postgresql://USER:PASSWORD@localhost:5432/DATABASE
#
# اگر رمز کاراکتر خاص یا فارسی دارد باید URL-encode شود.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ----- اختیاری (ابزارهای tools / Telethon) -----

# از https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# لینک دعوت کانال آرشیو خصوصی (اگر یوزرنیم عمومی ندارد)
# مثال: https://t.me/+xxxx  یا  https://t.me/ChannelName
CHANNEL_INVITE=

# یوزرنیم ربات بدون @
BOT_USERNAME=
